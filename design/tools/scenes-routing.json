[
 {
  "name": "routing-angels-landing",
  "path": "/",
  "viewport": [
   1440,
   900
  ],
  "steps": [
   {
    "wait": 5000
   },
   {
    "click": "#tripsHomeNewBtn"
   },
   {
    "wait": 500
   },
   {
    "type": [
     "#onboardingName",
     "Angels Landing"
    ]
   },
   {
    "click": "#onboardingSubmit"
   },
   {
    "wait": 1200
   },
   {
    "eval": "(async () => { const o = window.__outhere; o.applyRegion(o.findRegionById('zion'), { fly: false }); await new Promise((r) => o.map.once('idle', r)); return o.map.getStyle().name; })()"
   },
   {
    "click": "#addRouteBtn"
   },
   {
    "eval": "window.__outhere.routing.ready()"
   },
   {
    "eval": "void window.__outhere.map.jumpTo({ center: [-112.9515271,37.2599664], zoom: 14 })"
   },
   {
    "wait": 300
   },
   {
    "mapClickLngLat": [
     -112.9515271,
     37.2599664
    ]
   },
   {
    "eval": "window.__outhere.routing.idle().then(() => undefined)"
   },
   {
    "eval": "void window.__outhere.map.jumpTo({ center: [-112.94799,37.2693149], zoom: 14 })"
   },
   {
    "wait": 300
   },
   {
    "mapDblClickLngLat": [
     -112.94799,
     37.2693149
    ]
   },
   {
    "eval": "window.__outhere.routing.idle().then(() => undefined)"
   },
   {
    "wait": 300
   },
   {
    "eval": "(async () => { const o = window.__outhere; const r = o.TripManager.currentTrip.features.filter((f) => f.properties.type === 'route').at(-1); const c = r.geometry.coordinates; const b = c.reduce((b, p) => [Math.min(b[0], p[0]), Math.min(b[1], p[1]), Math.max(b[2], p[0]), Math.max(b[3], p[1])], [180, 90, -180, -90]); o.map.fitBounds([[b[0], b[1]], [b[2], b[3]]], { padding: { top: 80, bottom: 80, left: 80, right: 600 }, duration: 0 }); await new Promise((res) => o.map.once('idle', res)); })()"
   },
   {
    "wait": 1500
   },
   {
    "shot": "routing-angels-landing"
   },
   {
    "eval": "(() => { const r = window.__outhere.TripManager.currentTrip.features.filter((f) => f.properties.type === 'route').at(-1).properties; return { main_route_distance_mi: +r.main_route_distance_mi.toFixed(3), modes: r.segments.map((s) => s.mode + (s.reason ? ':' + s.reason : '')), legs_mi: r.segments.map((s) => +(s.length_m / 1609.344).toFixed(3)), routing: r.routing, vertex_snapped: r.vertex_snapped }; })()"
   },
   {
    "save": [
     "routing-angels-landing.trip.geojson",
     "window.__outhere.TripManager.buildExport()"
    ]
   }
  ]
 },
