[
 {
  "name": "report-gap-card",
  "path": "/?osmapi=sandbox",
  "viewport": [
   1440,
   900
  ],
  "steps": [
   {
    "wait": 5000
   },
   {
    "click": "#tripsHomeNewBtn"
   },
   {
    "wait": 500
   },
   {
    "type": [
     "#onboardingName",
     "Springdale gap"
    ]
   },
   {
    "click": "#onboardingSubmit"
   },
   {
    "wait": 1200
   },
   {
    "eval": "(async () => { const o = window.__outhere; o.applyRegion(o.findRegionById('zion'), { fly: false }); await new Promise((r) => o.map.once('idle', r)); return o.map.getStyle().name; })()"
   },
   {
    "click": "#addRouteBtn"
   },
   {
    "eval": "window.__outhere.routing.ready()"
   },
   {
    "eval": "void window.__outhere.map.jumpTo({ center: [-112.9849,37.2012], zoom: 14 })"
   },
   {
    "wait": 800
   },
   {
    "mapClickLngLat": [
     -112.983857,
     37.201728
    ]
   },
   {
    "eval": "window.__outhere.routing.idle().then(() => undefined)"
   },
   {
    "mapMoveLngLat": [
     -112.985952,
     37.200626
    ]
   },
   {
    "wait": 300
   },
   {
    "mapClickLngLat": [
     -112.985952,
     37.200626
    ]
   },
   {
    "eval": "window.__outhere.routing.idle().then(() => undefined)"
   },
   {
    "wait": 600
   },
   {
    "mapDblClickLngLat": [
     -112.985952,
     37.200626
    ]
   },
   {
    "eval": "window.__outhere.routing.idle().then(() => undefined)"
   },
   {
    "wait": 800
   },
   {
    "mapClickExpr": "window.__outhere.map.querySourceFeatures('trip').find((f) => f.properties.type === 'route_gap').geometry.coordinates"
   },
   {
    "wait": 600
   },
   {
    "wait": 600
   },
   {
    "shot": "01-gap-card"
   },
   {
    "click": "[data-gap-report]"
   },
   {
    "wait": 2500
   },
   {
    "shot": "02-gap-dialog"
   },
   {
    "eval": "document.getElementById('reportText')?.value"
   },
   {
    "click": "#reportSend"
   },
   {
    "wait": 4000
   },
   {
    "shot": "03-gap-sent"
   },
   {
    "eval": "document.querySelector('.report-body')?.innerText"
   },
   {
    "click": ".report-close"
   },
   {
    "wait": 300
   },
   {
    "mapClickExpr": "window.__outhere.map.querySourceFeatures('trip').find((f) => f.properties.type === 'route_gap').geometry.coordinates"
   },
   {
    "wait": 600
   },
   {
    "shot": "04-gap-card-reported"
   }
  ]
 },
